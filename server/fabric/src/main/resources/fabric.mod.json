{
  "schemaVersion": 1,
  "id": "boxloom",
  "version": "${version}",
  "name": "boxloom",
  "icon": "assets/boxloom/icon.png",
  "description": "Control Minecraft from Python through a local HTTP API provided by a server-side Fabric mod.",
  "authors": [
    "k-yokoishi"
  ],
  "contact": {
    "homepage": "https://github.com/k-yokoishi/boxloom",
    "sources": "https://github.com/k-yokoishi/boxloom",
    "issues": "https://github.com/k-yokoishi/boxloom/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "dev.boxloom.fabric.BoxloomMod"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api": ">=0.161.0",
    "fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20"
  }
}
