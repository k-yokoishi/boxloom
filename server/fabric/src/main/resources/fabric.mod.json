{
  "schemaVersion": 1,
  "id": "boxloom",
  "version": "${version}",
  "name": "boxloom",
  "description": "An authenticated server-side API for controlling Minecraft with boxloom SDKs.",
  "authors": [
    "boxloom contributors"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "dev.boxloom.fabric.BoxloomMod"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.2",
    "java": ">=25",
    "fabric-api": ">=0.156.0",
    "fabric-language-kotlin": ">=1.13.13+kotlin.2.4.10"
  }
}
