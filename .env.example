# Minecraft Java Edition connects to localhost:<MINECRAFT_PORT>.
MINECRAFT_BIND_ADDRESS=127.0.0.1
MINECRAFT_PORT=25566
MINECRAFT_MEMORY=2G

# Open code-server at http://localhost:<CODE_SERVER_PORT>.
CODE_SERVER_BIND_ADDRESS=127.0.0.1
CODE_SERVER_PORT=8080
CODE_SERVER_PASSWORD=boxloom-local

# Shared only between code-server and the boxloom mod API.
BOXLOOM_AUTH_TOKEN=boxloom-local-poc-token
